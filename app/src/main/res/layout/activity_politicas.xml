<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Politicas">

    <include
        android:id="@+id/include8"
        layout="@layout/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/saira_condensed_medium"
        android:text="Incumplimiento de Políticas"
        android:textColor="#B3B3B3"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include8" />

    <ImageView
        android:id="@+id/image1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/icon_seleccione_planta"
        app:layout_constraintBottom_toBottomOf="@+id/text1"
        app:layout_constraintEnd_toStartOf="@+id/text1"
        app:layout_constraintTop_toTopOf="@+id/text1" />


    <LinearLayout
        android:id="@+id/layout_historial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/text1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text1"
        android:background="@drawable/botones_next_back"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@+id/include8">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_history"
            />

        <TextView

            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:text="Historial"
            android:gravity="center"
            android:textColor="#E6E6E0"
            android:textSize="12dp"
            tools:layout_editor_absoluteX="375dp"
            tools:layout_editor_absoluteY="41dp" />

    </LinearLayout>



    <LinearLayout
        android:id="@+id/linearLayoutDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1">

        <LinearLayout
            android:id="@+id/linearLayout15"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <!-- TextView para el número de nómina -->
            <EditText
                android:id="@+id/editNomina"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@drawable/contorno"
                android:gravity="center"
                android:hint="Nómina"
                android:padding="8dp"
                android:text=""
                android:textSize="12sp" />
            <!-- TextView para el nombre -->
            <EditText
                android:id="@+id/editNombre"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@drawable/contorno"
                android:gravity="center"
                android:hint="Nombre del empleado que incumplió"
                android:padding="8dp"
                android:textSize="12sp" />
        </LinearLayout>
        <!-- EditText para los comentarios -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/img_record"
                    android:layout_width="40dp"
                    android:padding="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/boton_recorridos"
                    app:srcCompat="@drawable/ic_voz" />


                <ImageView
                    android:id="@+id/btn_limpiar"
                    android:layout_width="40dp"
                    android:padding="5dp"
                    android:layout_height="match_parent"
                    android:rotation="180"
                    android:paddingHorizontal="2dp"
                    android:layout_marginHorizontal="10dp"
                    android:scaleX="-1"
                    android:background="@drawable/boton_recorridos"
                    app:srcCompat="@drawable/ic_clean"/>
                <EditText
                    android:id="@+id/editComentario"
                    android:layout_width="0dp"
                    android:layout_marginLeft="2dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/contorno"
                    android:ems="10"
                    android:gravity="start|top"
                    android:hint="Comentarios"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textSize="12sp" />



            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/textArea"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingLeft="10dp"
                    android:gravity="center_vertical"
                    android:text="Área:"
                    android:textSize="14sp" />
                <ImageView
                    android:id="@+id/newSubArea"
                    android:layout_width="40dp"
                    android:padding="4dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/boton_recorridos"
                    app:srcCompat="@drawable/ic_new_in_list" />

                <Spinner
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/contorno"
                    android:id="@+id/spinneArea"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_weight="1"/>
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


    <ScrollView
        android:id="@+id/scrollPoliticas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/contorno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutDatos">

        <!-- Contenedor LinearLayout que contiene todas las políticas -->
        <LinearLayout
            android:id="@+id/layoutPoliticas"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp"
            android:layout_gravity="center"
            android:orientation="vertical"><!--android:background="@drawable/sombra_inferior"-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView29"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_list_number" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/saira_condensed_medium"
                    android:text="Favor de seleccionar la política inclumplida."
                    android:textColor="#222121"
                    android:textSize="15dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonPolitica1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="" />

                <ImageView
                    android:id="@+id/number1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_number_one" />

                <TextView
                    android:id="@+id/textViewP1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mitre"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="0.7"
                    android:paddingVertical="10dp"
                    android:text="Asignar un lugar especifico para cada herramienta."
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <RadioButton
                    android:id="@+id/radioButtonPolitica2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="" />

                <ImageView
                    android:id="@+id/number2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_number_two" />

                <TextView
                    android:id="@+id/textViewP2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mitre"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="0.7"
                    android:paddingVertical="10dp"
                    android:text="Retirar piezas, materiales o insumos que no se utilicen con frecuecia o estén obsoletos."
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <RadioButton
                    android:id="@+id/radioButtonPolitica3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="" />

                <ImageView
                    android:id="@+id/number3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_number_three" />

                <TextView
                    android:id="@+id/textViewP3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mitre"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="0.7"
                    android:paddingVertical="10dp"
                    android:text="Limpiar maquinaria, estaciones de trabajo y pisos como parte del turno."
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <RadioButton
                    android:id="@+id/radioButtonPolitica4"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="" />

                <ImageView
                    android:id="@+id/number4"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_number_four" />

                <TextView
                    android:id="@+id/textViewP4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mitre"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="0dp"
                    android:lineSpacingMultiplier="0.7"
                    android:paddingVertical="10dp"
                    android:text="Mantener ordenado el lugar de trabajo es responsabilidad del operador."
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <RadioButton
                    android:id="@+id/radioButtonPolitica5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="" />

                <ImageView
                    android:id="@+id/number5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_number_five" />

                <TextView
                    android:id="@+id/textViewP5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mitre"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="0.7"
                    android:paddingVertical="10dp"
                    android:text="Detectar y corregir de inmediato cualquier desviación en orden o limpieza. "
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout18"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="fill_vertical"
                android:orientation="horizontal"
                android:paddingTop="40dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView51"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Tomar evidencia"
                        android:textColor="#029385" />

                    <ImageView
                        android:id="@+id/imageEvidence"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/ic_camara_evidencia" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnGuardar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/boton_entrar"
                        android:text="GUARDAR"
                        android:textColor="@color/blaco" />

                    <TextView
                        android:id="@+id/waitingSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardando imágenes, espere por favor...."
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </ScrollView>


    <TableLayout
        android:id="@+id/TableCanva"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:stretchColumns="1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/scrollPoliticas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primera fila con 2 columnas -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:background="@drawable/ic_lienzo"
                android:gravity="center" />

            <TextView
                android:id="@+id/mensaje_lienzo"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Puedes marcar sobre la Imágen."
                android:textColor="#029385" />
        </TableRow>

        <!-- Segunda fila que abarca las dos columnas -->
        <TableRow
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="15dp"
            android:gravity="center">

            <com.example.a5SGonher.DrawView
                android:id="@+id/EspacioCanva"
                android:layout_width="wrap_content"
                android:layout_height="350dp"
                android:layout_span="2"
                android:layout_gravity="center"
                android:gravity="center" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:layout_span="2"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnSaveEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/boton_crear"
                    android:text="GUARDAR EDICIÓN"
                    android:textColor="#E6E6E0" />

            </LinearLayout>

        </TableRow>

    </TableLayout>

    <include
        android:id="@+id/include_layout_crear_nueva_area"
        layout="@layout/crear_nueva_area_politicas"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </include>


    <ImageView
        android:id="@+id/Pie"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:srcCompat="@drawable/fondo_pie" />

</androidx.constraintlayout.widget.ConstraintLayout>